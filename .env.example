# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com/api-keys) - used for task/due-date email notifications
RESEND_API_KEY=
# Verified sending address, e.g. "PMIS <notifications@yourdomain.com>"
RESEND_FROM_EMAIL=

# Anthropic (console.anthropic.com) - powers the AI Assist chat page
ANTHROPIC_API_KEY=

# Random secret shared with Vercel Cron to authorize the daily notification job.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Base URL of the deployed app, used to build links inside emails.
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Sheets sync (PIO Daily Accomplishments) - see scripts/google-apps-script.js
# for the Apps Script web app this posts to. Leave unset to disable the sync.
GOOGLE_SHEETS_WEBHOOK_URL=
# Must match SHARED_SECRET in the deployed Apps Script. Generate with: openssl rand -hex 32
GOOGLE_SHEETS_WEBHOOK_SECRET=
